#version 450
#extension GL_GOOGLE_include_directive : require

// One pass of the edge-avoiding a-trous denoiser. GPU port of ATrousDenoiser (Denoiser.cpp) - see there for the idea.
// Pass k reads the previous pass's output (pass 0 derives its input from the accumulation buffers directly) and writes
// demodulated irradiance + variance; the last pass instead writes the remodulated linear color and the display image.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "ToneMapping.glsl"

layout(binding = 0, rgba32f) uniform readonly image2D AccumulationImage; // rgb = radiance sum, a = sample count
layout(binding = 1, rgba32f) uniform readonly image2D AlbedoDepthImage;  // rgb = albedo sum, a = depth sum
layout(binding = 2, rgba32f) uniform readonly image2D NormalMomentImage; // xyz = normal sum, w = luminance^2 sum
layout(binding = 3, rgba32f) uniform image2D PingImage;
layout(binding = 4, rgba32f) uniform image2D PongImage;
layout(binding = 5, rgba8) uniform writeonly image2D DisplayImage;

layout(push_constant) uniform PushConstants {
	uint Width;
	uint Height;
	uint Iteration;
	uint IterationCount;
	float ColorSigma;
	float NormalSigma;
	float DepthSigma;
	float Exposure;
	uint ToneMapper;
	uint SRGBOutput;
} u_PC;

const float MIN_ALBEDO = 0.01;
const float KERNEL[5] = float[](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

float Luminance(vec3 color) { return dot(color, vec3(0.2126, 0.7152, 0.0722)); }

struct Features {
	vec3 Normal; // normalized average, or zero where the camera saw the sky
	float Depth;
	vec3 Albedo; // clamped away from zero for demodulation
};

Features LoadFeatures(ivec2 p)
{
	Features features;
	float sampleCount = imageLoad(AccumulationImage, p).a;
	if (sampleCount <= 0.0)
	{
		features.Normal = vec3(0.0);
		features.Depth = 0.0;
		features.Albedo = vec3(1.0);
		return features;
	}
	vec4 albedoDepth = imageLoad(AlbedoDepthImage, p);
	vec3 normal = imageLoad(NormalMomentImage, p).xyz / sampleCount;
	float normalLength = length(normal);
	features.Normal = normalLength > 1e-3 ? normal / normalLength : vec3(0.0);
	features.Depth = albedoDepth.a / sampleCount;
	features.Albedo = max(albedoDepth.rgb / sampleCount, vec3(MIN_ALBEDO));
	return features;
}

// Pass 0's input: demodulated irradiance and the variance of its mean luminance
vec4 LoadPrepared(ivec2 p)
{
	vec4 accumulated = imageLoad(AccumulationImage, p);
	float sampleCount = accumulated.a;
	if (sampleCount <= 0.0)
		return vec4(0.0);

	vec3 color = accumulated.rgb / sampleCount;
	vec3 albedo = max(imageLoad(AlbedoDepthImage, p).rgb / sampleCount, vec3(MIN_ALBEDO));
	float luminance = Luminance(color);
	float variance = max(0.0, imageLoad(NormalMomentImage, p).w / sampleCount - luminance * luminance) / sampleCount;
	float albedoLuminance = max(Luminance(albedo), MIN_ALBEDO);
	return vec4(color / albedo, variance / (albedoLuminance * albedoLuminance));
}

vec4 LoadSource(ivec2 p)
{
	if (u_PC.Iteration == 0u)
		return LoadPrepared(p);
	return (u_PC.Iteration % 2u == 1u) ? imageLoad(PingImage, p) : imageLoad(PongImage, p);
}

void StoreDestination(ivec2 p, vec4 value)
{
	if (u_PC.Iteration % 2u == 0u)
		imageStore(PingImage, p, value);
	else
		imageStore(PongImage, p, value);
}

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	int width = int(u_PC.Width), height = int(u_PC.Height);
	if (p.x >= width || p.y >= height)
		return;

	int step = 1 << u_PC.Iteration;
	vec4 center = LoadSource(p);
	Features centerFeatures = LoadFeatures(p);
	float centerLuminance = Luminance(center.rgb);
	float luminanceSigma = u_PC.ColorSigma * sqrt(max(center.a, 0.0)) + 1e-4;
	float depthSigma = u_PC.DepthSigma * centerFeatures.Depth * float(step) * 0.01 + 1e-4;
	bool centerHasNormal = dot(centerFeatures.Normal, centerFeatures.Normal) > 0.0;

	vec3 sum = vec3(0.0);
	float weightSum = 0.0, varianceSum = 0.0;
	for (int dy = -2; dy <= 2; dy++)
	{
		int qy = p.y + dy * step;
		if (qy < 0 || qy >= height)
			continue;
		for (int dx = -2; dx <= 2; dx++)
		{
			int qx = p.x + dx * step;
			if (qx < 0 || qx >= width)
				continue;
			ivec2 q = ivec2(qx, qy);
			vec4 tap = (dx == 0 && dy == 0) ? center : LoadSource(q);

			float weight = KERNEL[dx + 2] * KERNEL[dy + 2];
			if (dx != 0 || dy != 0)
			{
				Features tapFeatures = LoadFeatures(q);
				bool tapHasNormal = dot(tapFeatures.Normal, tapFeatures.Normal) > 0.0;
				float normalWeight = (centerHasNormal && tapHasNormal)
					? pow(max(0.0, dot(centerFeatures.Normal, tapFeatures.Normal)), u_PC.NormalSigma)
					: (centerHasNormal == tapHasNormal ? 1.0 : 0.0);
				float depthWeight = exp(-abs(centerFeatures.Depth - tapFeatures.Depth) / depthSigma);
				float luminanceWeight = exp(-abs(centerLuminance - Luminance(tap.rgb)) / luminanceSigma);
				weight *= normalWeight * depthWeight * luminanceWeight;
			}

			sum += weight * tap.rgb;
			weightSum += weight;
			varianceSum += weight * weight * tap.a;
		}
	}

	vec4 filtered = vec4(sum / weightSum, varianceSum / (weightSum * weightSum));

	if (u_PC.Iteration + 1u < u_PC.IterationCount)
	{
		StoreDestination(p, filtered);
		return;
	}

	// Last pass: remodulate, keep the linear result (for HDR export) and tone map it for display
	vec3 color = filtered.rgb * centerFeatures.Albedo;
	StoreDestination(p, vec4(color, 1.0));
	imageStore(DisplayImage, p, vec4(ApplyToneMapping(color, u_PC.Exposure, u_PC.ToneMapper, u_PC.SRGBOutput), 1.0));
}
